          <SubComponents>
            <Component class="javax.swing.JLabel" name="jLabel4">
              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Vijaya" size="18" style="0"/>
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;Avoidance behavior is another key to wellness. Below are described some of the major items to avoid if a person is seeking a healthy lifestyle. &lt;/html&gt;"/>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="jLabel3">
              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Vijaya" size="18" style="0"/>
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;**People taking medicine for mental health problems should not stop taking these medications, no matter how &quot;well&quot; they feel, until they have discussed their situation with their prescribing doctor(s).&lt;/html&gt;"/>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="jLabel2">
              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Vijaya" size="18" style="0"/>
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;**Seek help and advice early if you feel depressed, have&#xa0;suicidal thoughts, or consider harming yourself or others.&lt;/html&gt;"/>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="jLabel1">
              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Vijaya" size="18" style="0"/>
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;**Have a network of friends; those with strong social support systems lead healthier lives.&lt;/html&gt;"/>
              </Properties>
            </Component>
