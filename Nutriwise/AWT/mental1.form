          <SubComponents>
            <Component class="javax.swing.JLabel" name="jLabel2">
              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Vijaya" size="18" style="0"/>
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;**Do some mind exercises (read, do a puzzle occasionally during the week).&lt;/html&gt;"/>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="jLabel5">
              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Vijaya" size="18" style="0"/>
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;**Try to make some leisure time to do some things that interest you every week (hobby, sport).&lt;/html&gt;"/>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="jLabel1">
              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Vijaya" size="18" style="0"/>
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;**Try something new and often (eat a new food, try a different route to work, go to a new museum display).&lt;/html&gt;"/>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="jLabel6">
              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Vijaya" size="18" style="0"/>
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;**Learn ways to say &quot;no&quot; when something occurs that you do not want to do or be involved with.&lt;/html&gt;"/>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="jLabel7">
              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Vijaya" size="18" style="0"/>
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;**Have fun (go on a trip with someone you love, go shopping, go fishing; do not let vacation time slip away).&lt;/html&gt;"/>
              </Properties>
            </Component>
